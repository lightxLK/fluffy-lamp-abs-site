# Static export served directly by Apache (no Next.js server) — headers that
# would normally come from next.config `headers()` have to live here instead.

# --- MIME types ---
# Hostinger's server has no default mapping for .webm, so it fell back to
# text/plain — Chrome refuses to play video served with that content-type
# (surfaces as a network error, not a decode error).
<IfModule mod_mime.c>
  AddType video/webm .webm
  AddType video/mp4 .mp4
  AddType font/woff2 .woff2
</IfModule>

# next/og's static export writes the opengraph-image/twitter-image route
# output with no file extension — Next's own content-type manifest for
# them only ships to Vercel, not this out/ folder, so without ForceType
# Apache falls back to its DefaultType (text/plain or none) and social
# crawlers (Facebook/X/LinkedIn/WhatsApp) fail to render the share image.
<Files "opengraph-image">
  ForceType image/png
</Files>
<Files "twitter-image">
  ForceType image/png
</Files>

# --- Compression ---
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/css text/xml text/javascript
  AddOutputFilterByType DEFLATE application/javascript application/x-javascript
  AddOutputFilterByType DEFLATE application/json application/xml application/rss+xml
  AddOutputFilterByType DEFLATE image/svg+xml font/ttf font/otf application/vnd.ms-fontobject
</IfModule>

<IfModule mod_brotli.c>
  AddOutputFilterByType BROTLI_COMPRESS text/html text/plain text/css text/xml text/javascript
  AddOutputFilterByType BROTLI_COMPRESS application/javascript application/x-javascript
  AddOutputFilterByType BROTLI_COMPRESS application/json application/xml application/rss+xml
  AddOutputFilterByType BROTLI_COMPRESS image/svg+xml font/ttf font/otf application/vnd.ms-fontobject
</IfModule>

# --- Caching ---
<IfModule mod_expires.c>
  ExpiresActive On

  # _next/static/* is content-hashed by Next.js — safe to cache for a year, immutably.
  <FilesMatch "\.(js|css)$">
    ExpiresDefault "access plus 1 year"
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>

  <FilesMatch "\.(webp|png|jpe?g|svg|ico|avif)$">
    ExpiresDefault "access plus 1 year"
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>

  <FilesMatch "\.(woff2?|ttf|otf|eot)$">
    ExpiresDefault "access plus 1 year"
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>

  <FilesMatch "\.(webm|mp4)$">
    ExpiresDefault "access plus 1 month"
    Header set Cache-Control "public, max-age=2592000"
  </FilesMatch>

  <FilesMatch "\.html$">
    ExpiresDefault "access plus 0 seconds"
    Header set Cache-Control "public, max-age=0, must-revalidate"
  </FilesMatch>

  # Extensionless OG/Twitter image routes (see ForceType block above) —
  # cached briefly rather than immutably since a redesign won't change
  # the URL the way a content-hashed asset would.
  <FilesMatch "^(opengraph-image|twitter-image)$">
    ExpiresDefault "access plus 1 day"
    Header set Cache-Control "public, max-age=86400"
  </FilesMatch>
</IfModule>

# --- Security headers ---
# CSP/Trusted-Types are skipped deliberately: this site relies on inline
# scripts (theme toggle, JSON-LD) that would need nonce/hash plumbing we
# can't verify against a live server from here.
<IfModule mod_headers.c>
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"
</IfModule>
